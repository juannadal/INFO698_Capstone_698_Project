// The app's Worker: serves the React build (web/dist) and answers POST /api/ask.
// Local development: `npx wrangler dev` here (bindings run against the real Cloudflare resources), and
// `npm run dev` in web/, which proxies /api to port 8787.
{
  // Cloudflare Access (a sign-in) protects the public site, so run local `wrangler dev` with `--name aler-dev`.
  "name": "aging-lifestyle-research-explorer",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // /api/* runs the Worker; every other path is a file of the React build. Unknown paths get index.html so
  // React Router can show the right page.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  // pubmed-index: articles, chunks (with the FTS5 index chunks_fts), vocab, query_log and daily_usage.
  "d1_databases": [
    { "binding": "DB", "database_name": "pubmed-index", "database_id": "4dac97f3-2bb3-4727-af48-21607b3f14b2", "remote": true }
  ],
  // pubmed-chunks: one 768-number embedding per chunk, with the chunk_id as its id.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "pubmed-chunks", "remote": true }],
  // Save questions to the D1 table query_log (see worker/migrations/0001_query_log.sql). On since 2026-10-12: Juan
  // records every question for the capstone research. Download them as a CSV from the form at /api/questions.csv
  // (src/export.js; needs the EXPORT_KEY secret). An identical question within 30 seconds is saved once (index.js). Set to "false" and redeploy to stop saving; the page's "we save questions" note follows it.
  // DAILY_QUESTION_CAP: questions the whole site answers per day (UTC); at about $0.0014 each, 2,000 is about $3.
  // DAILY_QUESTION_CAP counts questions for both answer models.
  // CLAUDE_MODEL: the Claude model behind the "Answer written by: Claude" choice (src/claude.js); it needs the Worker
  // secret ANTHROPIC_API_KEY, and without it the page offers only Llama. CLAUDE_DAILY_CAP: Claude answers per day
  // (UTC), on top of the site cap. A Claude answer costs roughly $0.03 to $0.05 (about 30 times Llama), so 200 a day
  // is at most about $10.
  // GROK_MODEL / GROK_DAILY_CAP: the same for the "Grok" choice (src/grok.js, xAI API); needs the Worker secret
  // XAI_API_KEY. The non-reasoning Grok: grok-4.7 (a reasoning model) thought for over 60 seconds on a full prompt and
  // timed out locally on 2026-11-06. Models on the key: GET https://api.x.ai/v1/models.
  "vars": {
    "LOG_QUESTIONS": "true",
    "DAILY_QUESTION_CAP": "2000",
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CLAUDE_DAILY_CAP": "200",
    "GROK_MODEL": "grok-4.20-0309-non-reasoning",
    "GROK_DAILY_CAP": "200"
  },
  // About 10 questions a minute from one visitor. Cloudflare applies this approximately, so the daily cap above is
  // the firm limit on cost.
  "ratelimits": [{ "name": "ASK_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // The weekly refresh (src/refresh.js): every Sunday at 09:00 UTC (2:00 a.m. in Arizona), Cloudflare runs the
  // Worker's scheduled() handler, which adds the past week's new PubMed articles. Runs on Cloudflare, not on a Mac.
  // Each run is recorded in the D1 table refresh_log (migrations/0005_refresh_log.sql).
  // Written "SUN" because Cloudflare counts weekdays from 1 = Sunday (most cron tools use 1 = Monday).
  "triggers": { "crons": ["0 9 * * SUN"] },
  "observability": { "enabled": true }
}
